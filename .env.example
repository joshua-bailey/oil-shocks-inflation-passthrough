# Only needed to REFRESH the data via build_public_cache.py.
# The analysis runs offline from the committed data_cache/ with no key.
# Free FRED key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# Optional: BLS asks for a contact email in the User-Agent when downloading its
# relative-importance tables. No key required; leave unset and it is simply omitted.
# BLS_CONTACT_EMAIL=you@example.com
